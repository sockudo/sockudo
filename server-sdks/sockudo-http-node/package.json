{
  "name": "sockudo",
  "version": "2.2.0",
  "description": "Node.js client to interact with the Sockudo REST API",
  "keywords": [
    "realtime",
    "sockudo",
    "websockets"
  ],
  "homepage": "https://github.com/sockudo/sockudo/tree/master/server-sdks/sockudo-http-node#readme",
  "bugs": {
    "url": "https://github.com/sockudo/sockudo/issues"
  },
  "license": "MIT",
  "author": "Sockudo",
  "contributors": [
    {
      "name": "fabrik42",
      "email": "fabrik42@gmail.com"
    },
    {
      "name": "Jaewoong Kim",
      "email": "jwoongkim@gmail.com"
    },
    {
      "name": "Phil Leggetter",
      "email": "phil@leggetter.co.uk"
    },
    {
      "name": "Paweł Ledwoń",
      "email": "me@ludvik.pl"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sockudo/sockudo.git",
    "directory": "server-sdks/sockudo-http-node"
  },
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "main": "dist/sockudo.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "local-test": "npx mocha 'tests/integration/**/*.js'",
    "test": "npx mocha 'tests/integration/**/*.js' && npx mocha 'tests/remote/**/*.js'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prelocal-test": "npm run build",
    "pretest": "npm run build",
    "lint": "npx oxlint --config .oxlintrc.json src tests examples index.d.ts",
    "format": "npx oxfmt src tests examples index.d.ts package.json tsconfig.json .oxlintrc.json",
    "format:check": "npx oxfmt --check src tests examples index.d.ts package.json tsconfig.json .oxlintrc.json"
  },
  "dependencies": {
    "abort-controller": "^3.0.0",
    "is-base64": "^1.1.0",
    "node-fetch": "^2.7.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/node-fetch": "^2.6.13",
    "expect.js": "=0.3.1",
    "express": "^5.3.0",
    "https-proxy-agent": "^9.1.0",
    "mocha": "^12.0.3",
    "nock": "^14.0.17",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "sinon": "^22.1.0",
    "typescript": "^5.9.3",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  },
  "overrides": {
    "mocha": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    }
  },
  "engines": {
    "node": ">=16"
  }
}
