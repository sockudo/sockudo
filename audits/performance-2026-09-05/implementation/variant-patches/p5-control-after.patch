+async fn mysql_metadata_counts_preserve_legacy_and_latest_states() {
+    let config = DatabaseConnection {
+        host: "127.0.0.1".into(),
+        port: 13306,
+        username: "root".into(),
+        password: "root123".into(),
+        database: "sockudo".into(),
+        connection_pool_size: 1,
+        ..Default::default()
+    };
