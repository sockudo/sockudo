+}
+async fn session() -> Arc<Session> {
+    Arc::new(
+        SessionBuilder::new()
+            .known_node("127.0.0.1:19042")
+            .address_translator(Arc::new(FixtureAddress))
+            .disallow_shard_aware_port(true)
