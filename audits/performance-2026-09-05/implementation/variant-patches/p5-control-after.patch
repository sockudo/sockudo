+            .unwrap();
+        assert_eq!(second.items[0].interval_id, "2026-02-03:09:57");
+        assert_eq!(second.items[1].interval_id, "2026-02-03:09:56");
+        // An evicted calendar node must not make previously durable minutes invisible.
