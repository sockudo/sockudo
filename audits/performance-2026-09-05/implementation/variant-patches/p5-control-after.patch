+        let encoded =
+            encode_queue_payload(&PushQueuePayload::DeliveryBatch(Box::new(batch()))).unwrap();
+        let corrupted = encoded.replace("\"payloadGroup\":0", "\"payloadGroup\":999");
+        assert!(decode_queue_payload(&corrupted).is_err());
+    }
