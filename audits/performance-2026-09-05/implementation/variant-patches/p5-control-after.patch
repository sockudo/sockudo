+async fn postgres_feedback_restart_boundaries() {
+    let url = std::env::var("SOCKUDO_PUSH_TEST_POSTGRES_URL").unwrap();
+    let admin = sqlx::PgPool::connect(&url).await.unwrap();
+    let database = format!(
+        "sockudo_feedback_{}_{}",
