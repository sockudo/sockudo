+#[cfg(any(feature = "redis", feature = "nats"))]
+pub(crate) fn ingress_scope(payload: &[u8]) -> (Option<String>, Option<String>) {
+    #[derive(serde::Deserialize)]
+    struct Scope {
+        app_id: Option<String>,
