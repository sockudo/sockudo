+    let counts = [Arc::new(AtomicUsize::new(0)), Arc::new(AtomicUsize::new(0))];
+    for (transport, collector, count) in [
+        (&publisher, &a, counts[0].clone()),
+        (&second, &b, counts[1].clone()),
+    ] {
