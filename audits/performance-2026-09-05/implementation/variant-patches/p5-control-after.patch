+                .unwrap()
+                .success()
+        );
+        let guard = Paused(container.clone());
+        let health = transport.clone();
+        let started = Instant::now();
+        let task = tokio::spawn(async move { health.check_health().await });
+        tokio::time::sleep(Duration::from_millis(10)).await;
