+    ) -> PushStorageResult<bool> {
+        if token.len() != 64 || !token.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+            return Err(PushStorageError::Backend(
+                "invalid child admission token".to_owned(),
+            ));
