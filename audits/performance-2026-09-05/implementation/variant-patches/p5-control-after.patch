+    .unwrap();
+    crate::history::version_storage_tests::metadata_counts(&store).await;
+    // Simulate legacy imported rows whose boolean was not updated with latest.
+    let invalidate = format!("UPDATE {} SET state_version_serial = NULL, is_open_stream = FALSE WHERE app_id = 'audit' AND channel = 'metadata'", store.tables.version_messages);
+    sqlx::query(sqlx::AssertSqlSafe(invalidate.as_str())).execute(&store.pool).await.unwrap();
+    assert_eq!(store.active_stream_count("audit", "metadata").await.unwrap(), 68);
+    assert_eq!(store.active_stream_count("audit", "metadata").await.unwrap(), 68);
+}
