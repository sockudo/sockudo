+    tokio::time::timeout(Duration::from_secs(3), async {
+        while completed.load(Ordering::SeqCst) < 100 {
+            tokio::time::sleep(Duration::from_millis(1)).await;
+        }
+    })
+    .await
+    .unwrap();
+    assert_eq!(seen.lock().await.len(), 100);
+    manager.disconnect().await.unwrap();
+}
