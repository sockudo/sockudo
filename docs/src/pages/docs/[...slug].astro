---
import { render } from 'astro:content';
import { ArrowLeft, ArrowRight, CalendarDays, ChevronRight, Clock, Copy, FileText, PencilLine } from '@lucide/astro';
import Base from '@/layouts/Base.astro';
import Sidebar from '@/components/Sidebar.astro';
import Toc from '@/components/Toc.astro';
import GithubIcon from '@/components/GithubIcon.astro';
import { mdxComponents } from '@/components/mdx';
import { getBreadcrumb, getPrevNext, loadDocs, slugOf, type DocEntry } from '@/lib/docs';
import { repoUrl } from '@/lib/github';
import { pageMeta } from '@/lib/page-meta';

export async function getStaticPaths() {
  const { docs } = await loadDocs();
  return docs.map((entry) => ({ params: { slug: slugOf(entry) || undefined }, props: { entry } }));
}

const { entry } = Astro.props as { entry: DocEntry };
const slug = slugOf(entry);
const { Content, headings } = await render(entry);
const { prev, next } = await getPrevNext(slug);
const crumbs = await getBreadcrumb(slug);
const full = entry.data.full === true;
const mdUrl = `/docs${slug ? `/${slug}` : ''}.md`;
const meta = pageMeta(entry.body ?? '', entry.filePath);
const editUrl = `${repoUrl}/edit/master/docs/content/docs/${entry.filePath?.replace(/^content\/docs\//, '')}`;
---

<Base title={entry.data.title} description={entry.data.description} solidHeader showMenu footer={false}>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <div class:list={['docs-shell', { 'no-toc': full, full }]}>
    <Sidebar current={slug} />
    <main id="main-content" class="docs-main" data-pagefind-body>
      <article class="docs-article" transition:name="docs-content">
        {
          crumbs.length > 0 && (
            <nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
              {crumbs.map((c, i) => (
                <>
                  {i > 0 && <ChevronRight />}
                  <span>{c}</span>
                </>
              ))}
            </nav>
          )
        }
        <h1 class="page-title" data-pagefind-meta="title">{entry.data.title}</h1>
        {entry.data.description && <p class="page-desc">{entry.data.description}</p>}
        <div class="page-meta" data-pagefind-ignore>
          <span><Clock size={13} /> {meta.minutes} min read</span>
          {meta.updated && <span><CalendarDays size={13} /> Updated {meta.updated}</span>}
        </div>
        <div class="page-actions" data-pagefind-ignore>
          <button class="chip-btn" type="button" data-copy-page={mdUrl}><Copy /><span>Copy as Markdown</span></button>
          <a class="chip-btn" href={mdUrl}><FileText /><span>View .md</span></a>
          <a class="chip-btn" href={editUrl} target="_blank" rel="noreferrer"><PencilLine /><span>Edit on GitHub</span></a>
        </div>
        <div class="prose">
          <Content components={mdxComponents} />
        </div>
        <nav class="pager" aria-label="Pagination" data-pagefind-ignore>
          {
            prev && (
              <a class="prev glass" href={prev.href}>
                <small><ArrowLeft size={11} style="display:inline" /> Previous</small>
                <span>{prev.title}</span>
              </a>
            )
          }
          {
            next && (
              <a class="next glass" href={next.href}>
                <small>Next <ArrowRight size={11} style="display:inline" /></small>
                <span>{next.title}</span>
              </a>
            )
          }
        </nav>
        <div class="edit-row" data-pagefind-ignore>
          <a href={editUrl} target="_blank" rel="noreferrer"><GithubIcon size={14} /> Improve this page</a>
          <a href={`${repoUrl}/issues/new`} target="_blank" rel="noreferrer">Report an issue</a>
        </div>
      </article>
    </main>
    {!full && <Toc headings={headings} />}
  </div>
</Base>
